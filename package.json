{
  "name": "qmd-gui",
  "version": "1.0.0",
  "description": "Local web UI for the qmd CLI — search, collections, and index management",
  "type": "module",
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsup",
    "dev": "concurrently -k \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch src/server/cli.ts start --no-open",
    "start": "node bin/qmd-gui.js start",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:smoke": "vitest run -c vitest.smoke.config.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint"
  },
  "files": [
    "bin/",
    "dist/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "qmd-gui": "bin/qmd-gui.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ysskrishna/qmd-gui.git"
  },
  "bugs": {
    "url": "https://github.com/ysskrishna/qmd-gui/issues"
  },
  "homepage": "https://github.com/ysskrishna/qmd-gui#readme",
  "keywords": [
    "qmd",
    "qmd-gui",
    "search",
    "markdown",
    "local-search"
  ],
  "author": "Y. Siva Sai Krishna",
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "express": "^5.1.0",
    "express-basic-auth": "^1.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.6.0",
    "sonner": "^2.0.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^17.6.0",
    "lucide-react": "^0.554.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
